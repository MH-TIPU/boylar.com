# ─── Core ──────────────────────────────────────────────────────────────────────
# Public origin of the site. Used for SEO canonicals, sitemap, and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URI=postgres://user:password@localhost:5432/boylar_dev

# ─── Payload ───────────────────────────────────────────────────────────────────
# Signs auth tokens. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-openssl-rand-base64-32

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Contact-form notifications and subscriber auto-replies.
# Leave SMTP_HOST empty in development to log emails to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@boylar.com
SMTP_PASS=
EMAIL_FROM_NAME=Boylar
EMAIL_FROM_ADDRESS=info@boylar.com
# Where contact-form submissions are delivered.
EMAIL_TO_ADDRESS=info@boylar.com

# ─── Revalidation ──────────────────────────────────────────────────────────────
# Shared secret for the /api/revalidate webhook. openssl rand -hex 24
REVALIDATION_SECRET=change-me
