# Caddy obtains and renews TLS certificates automatically. Point SITE_DOMAIN's
# DNS A record at this server before starting, or issuance will fail.
{$SITE_DOMAIN} {
	encode zstd gzip

	# Payload's admin UI streams; disable buffering for it.
	reverse_proxy app:3000 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
